<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body data-page="home">
<%- include('partials/intro') %>
<a class="skip-link" href="#main">Skip to content</a>
<%- include('partials/nav') %>

<main id="main">

<section class="hero" id="heroCarousel">
  <div class="hero-bg active" id="heroBgA"></div>
  <div class="hero-bg" id="heroBgB"></div>
  <div class="wrap" id="heroWrapA"></div>
  <div class="wrap" id="heroWrapB"></div>
  <button class="hero-arrow left" id="heroPrev" aria-label="Previous highlight">‹</button>
  <button class="hero-arrow right" id="heroNext" aria-label="Next highlight">›</button>
  <div class="hero-dots" id="heroDots"></div>
  <button id="globalHeroBtn" class="btn ghost">Highlights</button>
</section>

  <section class="tight">
    <div class="wrap grid grid-feature">
      <div class="card reveal">
        <p class="eyebrow">Est. 1948</p>
        <h3 style="font-size:1.3rem;"><span id="icsoYears" data-founded="1948">0</span> years as Imperial's flagship orchestra</h3>
        <p>Conducted by Oliver Gooch, the Imperial College Symphony Orchestra (ICSO) has served as the flagship orchestra of Imperial College London since 1948. Being in the UK's only exclusively STEMB university, ICSO offers a fully auditioned, premier creative outlet for dedicated Imperial musicians, some of whom hold full Ash scholarships for lessons at the Royal College of Music. The orchestra delivers impactful, high-calibre performances to sold-out audiences across London, while also attracting interest abroad on international tours - most recently to Belgium in June 2026. Highlights from 2025-26 range from concertos by Dvořák (Robyn Liu, cello) and Korngold (Kaelyn Soh, violin), to Tchaikovsky's <i>Romeo and Juliet Fantasy Overture</i>, Shostakovich's <i>Symphony No. 9</i>, and Britten's monumental <i>War Requiem</i> in Windsor Castle, before HRH The Duke of Edinburgh and the German Ambassador to the UK.</p>
        <img src="/assets/strings-rach-prok-2025.jpg" alt="ICSO performing in concert" class="feature-card-photo">
      </div>
      <div class="card reveal">
        <p class="eyebrow">Prizes</p>
        <h3 style="font-size:1.3rem;">Awards and recognition</h3>
        <p>Having won "Universiy Orchestra of the Year" (2008) and with a BAFTA-awarded TV debut on Channel 4 (2002), ICSO is widely regarded as one of the finest university orchestras in the UK.</p>
        <p>ICSO's recognition has also been highlighted in the words of Daniel Jemison (LSO Principal Bassoon), who has previously described ICSO as sounding "like a professional orchestra".</p>
      </div>
      <div class="card reveal">
        <p class="eyebrow">In London and going abroad</p>
        <h3 style="font-size:1.3rem;">Cadogan Hall, London, and abroad</h3>
        <p>ICSO holds its annual Spring Concert at Cadogan Hall, a top orchestral venue and home of the RPO. Additionally, ICSO recently performed in Imperial's Great Hall, RCM's Amaryllis Fleming Hall, and Windsor Castle. International tours held by ICSO have also led the orchestra beyond the UK, to Spain, South Africa, Italy, Finland, Czechia, and Belgium.</p>
      </div>
    </div>
  </section>

  <!-- <hr class="divider"> -->

  <section id="recent-highlights">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Watch & Listen</p>
      <h2>Recent Highlights</h2>
    </div>

    <div class="media-hub reveal">
      
      <!-- LEFT SIDE: Main Video -->
      <div class="media-hub-main">
        <div class="media-slot" id="highlightVideo">
          <iframe id="mainPlayer" src="https://www.youtube.com/embed/-f0cP-uu2Wo?mute=1&start=5497&enablejsapi=1&rel=0&modestbranding=1&iv_load_policy=3" allow="autoplay; encrypted-media" allowfullscreen style="width:100%; height:100%; border:0;"></iframe>
          
          <!-- Custom Mute/Unmute Toggle Button -->
          <button class="unmute-btn" id="customMuteToggle">
            <span id="muteIcon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px; margin-top:-2px;">
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                <line x1="23" y1="9" x2="17" y2="15"></line>
                <line x1="17" y1="9" x2="23" y2="15"></line>
              </svg>
            </span>
            <span id="muteText">Unmute</span>
          </button>
        </div>
      </div>
      
      <!-- RIGHT SIDE: Scrollable Clips List -->
      <div class="media-hub-list">
        
        <div class="media-hub-item active" data-video-id="-f0cP-uu2Wo" data-start="5497">
          <div class="media-hub-thumb" style="background: url('https://img.youtube.com/vi/-f0cP-uu2Wo/mqdefault.jpg') center/cover;"></div>
          <div class="media-hub-text">
            <span class="hub-date">Mar 2025, Cadogan Hall</span>
            <span class="hub-title">Prokofiev's Fifth Symphony</span>
            <span class="hub-subtitle">+ Rachmaninoff's Third Piano Concerto (Bendit Chan, piano)</span>
          </div>
        </div>  

        <div class="media-hub-item" data-video-id="Yv8RCw-c86g" data-start="4848">
          <div class="media-hub-thumb" style="background: url('https://img.youtube.com/vi/Yv8RCw-c86g/mqdefault.jpg') center/cover;"></div>
          <div class="media-hub-text">
            <span class="hub-date">Mar 2022, Cadogan Hall</span>
            <span class="hub-title">Nielsen's Fourth Symphony</span>
            <span class="hub-subtitle">+ Brahms' Shicksalslied (Song of Destiny) + R. Strauss' Four Last Songs (Francesca Chiejina, soprano)</span>
          </div>
        </div>

        <div class="media-hub-item" data-video-id="9Zhs4WvOpqI" data-start="1953">
          <div class="media-hub-thumb" style="background: url('https://img.youtube.com/vi/9Zhs4WvOpqI/mqdefault.jpg') center/cover;"></div>
          <div class="media-hub-text">
            <span class="hub-date">Jun 2026, Sint-Stefanuskerk Sint-Margrietstraat (Ghent)</span>
            <span class="hub-title">Dvořák: Cello Concerto in B minor (Robyn Liu, cello) [clip]</span>
            <span class="hub-subtitle">+ Giminéz's Intermedio (from La Boda de Luis Alonso) + Rimsky-Korsakov's Capriccio Espagnol</span>
          </div>
        </div>

      </div>
    </div>

    <div style="text-align: center; margin-top: 32px;">
      <p><i>Unfortunately, only recordings of works that have entered the public domain can be made freely available.<br>For a written list of all recent ICSO repertoire:</i></p>
      <a href="/concerts" class="btn">View All Concerts</a>
    </div>
  </div>
</section>
</main>

<%- include('partials/footer') %>

  <script>
  const heroSlides = [
    { img:'/assets/2025-rehearsal-korngold-kaelyn-soh.jpg', eyebrow:'Open rehearsal • 30 September 2026', title:'Open Rehearsal', lede:"<b>Wednesday 30 September 2026: Senior Common Room</b><br>Ever wondered what it's like to be in ICSO? Come along to our Open Rehearsal on the first Wednesday evening of the term - <b>auditions are NOT required for this rehearsal</b>! We'll sight-read through this term's repertoire, have some (free!) pizza, and go to the pub (no alcohol required). <a href='https://forms.cloud.microsoft/e/LXypfmCGMn'>Sign up here!</a>"},
    { img:'/assets/2026-windsor-war-requiem-britten (7) v2.jpg', eyebrow:'Next concert • 22 November 2026', title:'Winter Concert', lede:"<b>Sunday 22 November 2026: Amaryllis Fleming Hall (Royal College of Music)</b><br>Performing <i>Prelude to Act 1</i> of Wagner's <i>Lohengrin</i>, Elgar's <i>Cello Concerto</i> (Ben Cummings, cello), and Rachmaninoff's <i>Symphony No. 2</i>. Tickets released soon!<br><br>Want to join ICSO? <a href='/join'>View our FAQs</a>." },
    { img:'/assets/2026-jun-summer-concert-3.jpeg', eyebrow:'Past highlight • June 2026', title:'Tour to Belgium', lede:"ICSO teamed up with London-based, Belgian, and Spanish university orchestras for concerts in Ghent. The amassed orchestra welcome back Robyn Liu (cello), bringing the ICSO summer repertoire and tour energy to their week abroad amidst the June heatwave." },
    { img:'/assets/2026-jun-summer-concert.jpeg', eyebrow:'Past highlight • June 2026', title:'Summer Concert', lede:"Featuring 4th-year biomedical engineer Robyn Liu on cello, ICSO takes to St Stephen's Church, Gloucester Road for their summer concert: Giminéz's <i>Intermedio</i> from <i>La Boda de Luis Alonso</i>, Dvořák's <i>Cello Concerto</i>, and Rimsky-Korsakov's <i>Capriccio Espagnol</i>." },
    { img:'/assets/2026-windsor-war-requiem-britten (1).jpg', eyebrow:'Past highlight • 28 February 2026', title:"Britten: War Requiem", lede:"ICSO joins with Imperial College Choirs, Coventry Cathedral Chorus, Orpheus Sinfonia, the Choristers of St George's Chapel and solo voices to perform Benjamin Britten's pacifist masterwork at St George's Chapel, Windsor Castle (including performing to HRH The Duke of Edinburgh and the German Ambassador to the UK)." },
  ];
window.__heroSlides = heroSlides;
</script>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const mainPlayer = document.getElementById('mainPlayer');
  const items = document.querySelectorAll('.media-hub-item');
  const muteToggleBtn = document.getElementById('customMuteToggle');
  const muteText = document.getElementById('muteText');
  const muteIcon = document.getElementById('muteIcon');
  
  let hasAutoPlayed = false;
  let isMuted = true;

  const iconUnmute = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px; margin-top:-2px;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>`;
  const iconMute = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px; margin-top:-2px;"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>`;

  muteToggleBtn.addEventListener('click', function() {
    if (isMuted) {
      mainPlayer.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'unMute', args: [] }), '*');
      mainPlayer.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'setVolume', args: [100] }), '*');
      muteText.textContent = 'Mute';
      muteIcon.innerHTML = iconMute;
      isMuted = false;
    } else {
      mainPlayer.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'mute', args: [] }), '*');
      muteText.textContent = 'Unmute';
      muteIcon.innerHTML = iconUnmute;
      isMuted = true;
    }
  });

  const scrollObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !hasAutoPlayed) {
        let currentSrc = mainPlayer.src;
        if (!currentSrc.includes('autoplay=1')) {
          mainPlayer.src = currentSrc + '&autoplay=1';
        }
        hasAutoPlayed = true; 
      }
    });
  }, { threshold: 0.5 }); 

  const highlightVideo = document.getElementById('highlightVideo');
  if (highlightVideo) {
    scrollObserver.observe(highlightVideo);
  }

  items.forEach(item => {
    item.addEventListener('click', function() {
      items.forEach(el => el.classList.remove('active'));
      this.classList.add('active');
      
      const videoId = this.getAttribute('data-video-id');
      const startTimestamp = this.getAttribute('data-start'); 
      
      let newSrc = `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&enablejsapi=1&rel=0&modestbranding=1&iv_load_policy=3`;
      if (startTimestamp) {
        newSrc += `&start=${startTimestamp}`;
      }
      
      mainPlayer.src = newSrc;
      
      isMuted = true;
      muteText.textContent = 'Unmute';
      muteIcon.innerHTML = iconUnmute;
    });
  });

  const globalHeroBtn = document.getElementById('globalHeroBtn');
  if (globalHeroBtn) {
    globalHeroBtn.addEventListener('click', function(e) {
      e.preventDefault();
      
      const section = document.getElementById('recent-highlights');
      
      if (section) {
        section.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }
});

document.querySelectorAll('.card').forEach(card => {
  const btn = document.createElement('div');
  btn.className = 'read-more-btn';
  btn.innerHTML = 'Read more ▼';
  card.appendChild(btn);

  card.addEventListener('click', function() {
    this.classList.toggle('expanded');
    const isExpanded = this.classList.contains('expanded');
    this.querySelector('.read-more-btn').innerHTML = isExpanded ? 'Show less ▲' : 'Read more ▼';
  });
});

const preloadContainer = document.createElement('div');
preloadContainer.style.cssText = 'position: absolute; width: 1px; height: 1px; overflow: hidden; opacity: 0; pointer-events: none; top: -9999px; left: -9999px;';
document.body.appendChild(preloadContainer);

window.__heroPreloaded = heroSlides.map(slide => {
  const link = document.createElement('link');
  link.rel = 'preload';
  link.as = 'image';
  link.href = slide.img;
  document.head.appendChild(link);

  const div = document.createElement('div');
  div.style.backgroundImage = `url("${slide.img}")`;
  div.style.width = '1px';
  div.style.height = '1px';
  preloadContainer.appendChild(div);

  return div;
});
</script>
</body>
</html>
